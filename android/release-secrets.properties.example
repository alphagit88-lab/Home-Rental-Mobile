# Copy this file to android/release-secrets.properties before building a release.
# That local file is ignored by git so your signing keys and API keys stay private.
APP_UPLOAD_STORE_FILE=app/home-rent-upload-key.jks
APP_UPLOAD_KEY_ALIAS=home-rent-upload
APP_UPLOAD_STORE_PASSWORD=replace-with-strong-password
APP_UPLOAD_KEY_PASSWORD=replace-with-strong-password
GOOGLE_MAPS_API_KEY=replace-with-your-restricted-google-maps-api-key
